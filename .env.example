# ASTRIX configuration — copy to .env and edit.
# Every value below has a working default; nothing here is required to run the demo.

# ---------- Agent reasoning (LLM) ----------
# Without a key ASTRIX runs in DETERMINISTIC mode: every agent falls back to its
# rule-based reasoner. The loop, safety engine and digital twin are unaffected.
# ANTHROPIC_API_KEY=sk-ant-...
ASTRIX_LLM_MODEL=claude-opus-5
ASTRIX_LLM_ENABLED=true

# ---------- Structured memory ----------
# Default: SQLite file at data/astrix.db
# Postgres: postgresql+psycopg://astrix:astrix@localhost:5432/astrix
ASTRIX_DATABASE_URL=sqlite:///data/astrix.db

# ---------- Vector memory ----------
# json   — zero-dependency numpy cosine store persisted to data/vector_store.json
# chroma — requires `pip install chromadb`
ASTRIX_VECTOR_BACKEND=json

# ---------- Autonomy ----------
# Highest risk level ASTRIX may execute without a human. GREEN is flight-safe default.
ASTRIX_AUTO_EXECUTE_MAX_RISK=GREEN

# ---------- Telemetry ----------
ASTRIX_TELEMETRY_WINDOW=180
ASTRIX_API_BASE=http://127.0.0.1:8000

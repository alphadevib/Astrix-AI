# Astrix-AI configuration — copy to .env and edit.
# Every value below has a working default; nothing here is required to run the demo.

# ---------- Agent reasoning (multi-model gateway) ----------
# Without a key Astrix-AI runs in DETERMINISTIC mode: every agent falls back to its
# rule-based reasoner. The loop, safety engine, knowledge graph and digital twin are unaffected.
# Providers can also be switched at runtime from the console's reasoner menu.
#
# ASTRIX_LLM_PROVIDER: auto | gemini | groq | huggingface | local
ASTRIX_LLM_PROVIDER=auto
ASTRIX_LLM_ENABLED=true
#
# Free tiers (see README for limits):
# GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# GROQ_API_KEY=              # https://console.groq.com/keys
# HF_TOKEN=                  # https://huggingface.co/settings/tokens
# Local (Ollama): no key. ASTRIX_LLM_MODEL picks the local model when the provider is local.
# ASTRIX_LOCAL_MODEL_URL=http://localhost:11434/v1
# ASTRIX_LLM_MODEL=qwen3:8b
# Per-provider model override: ASTRIX_<PROVIDER>_MODEL, e.g. ASTRIX_GROQ_MODEL=qwen/qwen3-32b

# ---------- Deployment security ----------
# Required on any public backend: every state-changing request must send this bearer token.
# ASTRIX_API_TOKEN=
# Allow the Vercel console (JSON list and/or regex):
# ASTRIX_CORS_ORIGINS=["https://astrix.example.com"]
# ASTRIX_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ---------- Astrix-LM training corpus ----------
# Fernet key for encrypting the corpus at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key file is generated at data/corpus/.corpus.key (development only).
# ASTRIX_CORPUS_KEY=
# ASTRIX_CORPUS_AUTO_TRAIN_EVERY=40

# ---------- Structured memory ----------
# Default: SQLite file at data/astrix.db
# Postgres: postgresql+psycopg://astrix:astrix@localhost:5432/astrix
ASTRIX_DATABASE_URL=sqlite:///data/astrix.db

# ---------- Vector memory ----------
# json   — zero-dependency numpy cosine store persisted to data/vector_store.json
# chroma — requires `pip install chromadb`
ASTRIX_VECTOR_BACKEND=json

# ---------- Autonomy ----------
# Highest risk level Astrix-AI may execute without a human. GREEN is flight-safe default.
ASTRIX_AUTO_EXECUTE_MAX_RISK=GREEN

# ---------- Telemetry ----------
ASTRIX_TELEMETRY_WINDOW=180
ASTRIX_API_BASE=http://127.0.0.1:8000

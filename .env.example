# Astrix-AI configuration — copy to .env and edit.
# Every value below has a working default; nothing here is required to run the demo.

# ---------- Agent reasoning (Multi-Model Gateway) ----------
# Without a key Astrix-AI runs in DETERMINISTIC mode: every agent falls back to its
# rule-based reasoner. The loop, safety engine, knowledge graph and digital twin are unaffected.
#
# Supported Providers:
# 1. Anthropic: ANTHROPIC_API_KEY=sk-ant-...
# 2. Google Gemini (Free Tier via Google AI Studio): GEMINI_API_KEY=AIzaSy...
# 3. Groq (Free Tier): GROQ_API_KEY=gsk_...
# 4. OpenAI: OPENAI_API_KEY=sk-...
# 5. Local Ollama / vLLM: ASTRIX_LOCAL_MODEL_URL=http://localhost:11434/v1
#
# ASTRIX_LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
ASTRIX_LLM_MODEL=claude-3-7-sonnet-20250219
ASTRIX_LLM_FAST_MODEL=claude-3-5-haiku-20241022
ASTRIX_LLM_ENABLED=true

# ---------- Structured memory ----------
# Default: SQLite file at data/astrix.db
# Postgres: postgresql+psycopg://astrix:astrix@localhost:5432/astrix
ASTRIX_DATABASE_URL=sqlite:///data/astrix.db

# ---------- Vector memory ----------
# json   — zero-dependency numpy cosine store persisted to data/vector_store.json
# chroma — requires `pip install chromadb`
ASTRIX_VECTOR_BACKEND=json

# ---------- Autonomy ----------
# Highest risk level Astrix-AI may execute without a human. GREEN is flight-safe default.
ASTRIX_AUTO_EXECUTE_MAX_RISK=GREEN

# ---------- Telemetry ----------
ASTRIX_TELEMETRY_WINDOW=180
ASTRIX_API_BASE=http://127.0.0.1:8000
